<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RevitTargetFramework)</TargetFramework><PlatformTarget>x64</PlatformTarget>
    <Version>0.3.0</Version><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RequiredInformationCommand.cs" /><Compile Include="RequiredInformationReader.cs" /><Compile Include="ExcelReportProcess.cs" />
    <Compile Include="BridgeApplication.cs" /><Compile Include="BridgeCommands.cs" />
    <Compile Include="ReadinessExternalEventHandler.cs" /><Compile Include="RevitReadinessExecutor.cs" />
    <Compile Include="RevitContextCatalog.cs" /><Compile Include="ReadinessPayloadCodec.cs" />
    <Reference Include="System.Web.Extensions" Condition="'$(TargetFramework)' == 'net48'" /><Reference Include="System.Runtime.Serialization" Condition="'$(TargetFramework)' == 'net48'" />
    <ProjectReference Include="../bridge-runtime/BimAgentLab.RevitBridge.Runtime.csproj" />
    <ProjectReference Include="../readiness-core/BimAgentLab.Readiness.Core.csproj" />
    <!-- Build-order dependency only: the exporter remains a separate net48 process. -->
    <ProjectReference Include="../excel-report/BimAgentLab.Readiness.Excel.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <Reference Include="RevitAPI"><HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
