<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/bridge-runtime/BimAgentLab.RevitBridge.Runtime.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <ProjectReference Include="../../src/revit-addin/BimAgentLab.RevitReadiness.csproj" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
